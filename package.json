{
  "name": "offbeat",
  "version": "0.1.0",
  "private": true,
  "description": "OFFBEAT — Community-powered travel discovery platform",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "verify": "node scripts/verify-phase-0.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm verify && pnpm lint && pnpm format:check",
    "dev": "pnpm --if-present --recursive --parallel dev",
    "build": "pnpm --if-present --recursive build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
