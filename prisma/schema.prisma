// OFFBEAT — Prisma Database Schema
// Phase 5: Geography & Place Data Layer

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RegionType {
  STATE
  UNION_TERRITORY
  PROVINCE
  EQUIVALENT
}

enum DestinationStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum PlaceStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile Profile?
  submissions CommunitySubmission[]
  supports    SubmissionSupport[]
  reports     SubmissionReport[]
  timeObservations TimeObservation[]
  crowdObservations CrowdObservation[]
  memories          TravelerMemory[]
  memoryEvents      MemoryEvent[]
  memorySetting     TravelerMemorySetting?

  @@index([email])
  @@index([username])
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  homeCountry String?  @map("home_country")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model Country {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  slug      String   @unique
  geometry  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  regions Region[]

  @@index([slug])
  @@index([code])
  @@map("countries")
}

model Region {
  id          String     @id @default(uuid())
  countryId   String     @map("country_id")
  name        String
  code        String
  type        RegionType @default(STATE)
  slug        String
  description String?
  geometry    Json
  centroid    Json
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  country      Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  destinations Destination[]

  @@unique([countryId, slug])
  @@unique([countryId, code])
  @@index([countryId])
  @@index([slug])
  @@index([code])
  @@map("regions")
}

model Destination {
  id          String            @id @default(uuid())
  regionId    String            @map("region_id")
  name        String
  slug        String
  description String?
  coordinates Json?
  imageUrl    String?           @map("image_url")
  status      DestinationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  region Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  places Place[]
  communitySubmissions CommunitySubmission[]
  crowdObservations CrowdObservation[]

  @@unique([regionId, slug])
  @@index([regionId])
  @@index([slug])
  @@map("destinations")
}

model Place {
  id            String      @id @default(uuid())
  destinationId String      @map("destination_id")
  name          String
  slug          String
  description   String?
  latitude      Float
  longitude     Float
  address       String?
  website       String?
  phone         String?
  imageUrl      String?     @map("image_url")
  status        PlaceStatus @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  destination Destination             @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  categories  PlaceCategoryRelation[]
  externalReferences ExternalPlaceReference[]
  communitySubmissions CommunitySubmission[]
  timeObservations TimeObservation[]
  crowdObservations CrowdObservation[]

  @@unique([destinationId, slug])
  @@index([destinationId])
  @@index([slug])
  @@map("places")
}

model PlaceCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  places PlaceCategoryRelation[]

  @@index([slug])
  @@map("place_categories")
}

model PlaceCategoryRelation {
  id         String   @id @default(uuid())
  placeId    String   @map("place_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  place    Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category PlaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([placeId, categoryId])
  @@index([placeId])
  @@index([categoryId])
  @@map("place_category_relations")
}

model ExternalPlaceReference {
  id           String    @id @default(uuid())
  placeId      String?   @map("place_id")
  provider     String    @default("SERPAPI")
  externalId   String    @map("external_id")
  sourceUrl    String?   @map("source_url")
  metadata     Json?
  lastSyncedAt DateTime  @default(now()) @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  place Place? @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([placeId])
  @@index([provider])
  @@index([externalId])
  @@map("external_place_references")
}

model SearchCache {
  id        String   @id @default(uuid())
  provider  String   @default("SERPAPI")
  queryHash String   @unique @map("query_hash")
  query     Json
  response  Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@index([queryHash])
  @@index([expiresAt])
  @@map("search_caches")
}

// ==========================================
// Phase 8: Community Intelligence Domain
// ==========================================

enum SubmissionType {
  HIDDEN_PLACE
  LOCAL_BUSINESS
  RESTAURANT
  PHOTO_SPOT
  BEST_TIME
  CROWD_TIP
  TRAVEL_TIP
  LOCAL_SPECIALTY
  TAKE_HOME
  EXPERIENCE
  ALTERNATIVE
  OTHER
}

enum SubmissionStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum EvidenceType {
  PHOTO
  TEXT
  EXTERNAL_REFERENCE
}

enum SupportType {
  AGREE
  USEFUL
  CONFIRM
}

enum ReportReason {
  INCORRECT
  OUTDATED
  DUPLICATE
  SPAM
  MISLEADING
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model CommunitySubmission {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  placeId       String?          @map("place_id")
  destinationId String?          @map("destination_id")
  type          SubmissionType
  title         String
  content       String
  status        SubmissionStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place             Place?                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  destination       Destination?          @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  evidence          SubmissionEvidence[]
  supports          SubmissionSupport[]
  reports           SubmissionReport[]
  verifications     VerificationRecord[]
  confidenceRecords ConfidenceRecord[]

  @@index([userId])
  @@index([placeId])
  @@index([destinationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("community_submissions")
}

model SubmissionEvidence {
  id                String       @id @default(uuid())
  submissionId      String       @map("submission_id")
  type              EvidenceType
  source            String?
  content           String?
  mediaUrl          String?      @map("media_url")
  externalReference String?      @map("external_reference")
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at")

  submission CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([type])
  @@map("submission_evidence")
}

model SubmissionSupport {
  id           String      @id @default(uuid())
  submissionId String      @map("submission_id")
  userId       String      @map("user_id")
  type         SupportType @default(USEFUL)
  createdAt    DateTime    @default(now()) @map("created_at")

  submission CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId, type])
  @@index([submissionId])
  @@index([userId])
  @@map("submission_supports")
}

model SubmissionReport {
  id           String       @id @default(uuid())
  submissionId String       @map("submission_id")
  userId       String       @map("user_id")
  reason       ReportReason
  description  String?
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")
  resolvedAt   DateTime?    @map("resolved_at")

  submission CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([userId])
  @@index([status])
  @@map("submission_reports")
}

// ==========================================
// Phase 9: Verification & Confidence Domain
// ==========================================

enum VerificationStatus {
  PENDING
  COMMUNITY_SUPPORTED
  COMMUNITY_VERIFIED
  FLAGGED
  REJECTED
}

enum VerificationMethod {
  COMMUNITY_SIGNAL
  EVIDENCE_REVIEW
  EXTERNAL_CORROBORATION
  DETERMINISTIC_RULES
  MANUAL_REVIEW
}

model VerificationRecord {
  id           String             @id @default(uuid())
  submissionId String             @map("submission_id")
  status       VerificationStatus @default(PENDING)
  method       VerificationMethod @default(DETERMINISTIC_RULES)
  reviewer     String?
  reasoning    String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  submission CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([status])
  @@index([method])
  @@map("verification_records")
}

model ConfidenceRecord {
  id                    String   @id @default(uuid())
  submissionId          String   @map("submission_id")
  score                 Float
  evidenceCount         Int      @map("evidence_count")
  supportCount          Int      @map("support_count")
  contradictionCount    Int      @map("contradiction_count")
  externalCorroboration Boolean  @default(false) @map("external_corroboration")
  reasoning             Json?
  calculatedAt          DateTime @default(now()) @map("calculated_at")
  version               String   @default("confidence-v1")

  submission CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([calculatedAt])
  @@map("confidence_records")
}

// ==========================================
// Phase 10: Time & Crowd Intelligence Domain
// ==========================================

enum TimeObservationType {
  OPENING_TIME
  CLOSING_TIME
  BEST_TIME
  SUNRISE_TIME
  SUNSET_TIME
  LOW_CROWD_TIME
  COMMUNITY_RECOMMENDED_TIME
}

enum ObservationSource {
  EXTERNAL
  COMMUNITY
  SYSTEM
}

enum DayType {
  WEEKDAY
  WEEKEND
  ANY
}

enum CrowdLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum Season {
  SPRING
  SUMMER
  MONSOON
  AUTUMN
  WINTER
  ANY
  UNKNOWN
}

model TimeObservation {
  id          String              @id @default(uuid())
  placeId     String              @map("place_id")
  userId      String?             @map("user_id")
  type        TimeObservationType
  startTime   String              @map("start_time")
  endTime     String              @map("end_time")
  dayType     DayType             @default(ANY) @map("day_type")
  observation String?
  source      ObservationSource   @default(COMMUNITY)
  confidence  Float?              @default(0.8)
  createdAt   DateTime            @default(now()) @map("created_at")
  expiresAt   DateTime?           @map("expires_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([placeId])
  @@index([type])
  @@index([dayType])
  @@index([expiresAt])
  @@map("time_observations")
}

model CrowdObservation {
  id            String            @id @default(uuid())
  placeId       String?           @map("place_id")
  destinationId String?           @map("destination_id")
  userId        String?           @map("user_id")
  level         CrowdLevel
  timeStart     String?           @map("time_start")
  timeEnd       String?           @map("time_end")
  dayType       DayType           @default(ANY) @map("day_type")
  season        Season            @default(ANY)
  observation   String?
  source        ObservationSource @default(COMMUNITY)
  createdAt     DateTime          @default(now()) @map("created_at")
  expiresAt     DateTime?         @map("expires_at")

  place       Place?       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([placeId])
  @@index([destinationId])
  @@index([level])
  @@index([dayType])
  @@index([expiresAt])
  @@map("crowd_observations")
}

enum MemoryType {
  TASTE
  EXPERIENCE
  TIME_PREFERENCE
  PACE
  CATEGORY_AFFINITY
  DESTINATION_AFFINITY
  PLACE_AFFINITY
  ALTERNATIVE_PREFERENCE
  TAKE_HOME_PREFERENCE
  ITINERARY_PREFERENCE
}

enum MemorySource {
  EXPLICIT
  INFERRED
  INTERACTION
  ITINERARY
  ALTERNATIVE
  TAKE_HOME
  SYSTEM
}

enum MemoryConfidence {
  LOW
  MODERATE
  HIGH
}

enum MemoryEventType {
  TASTE_SELECTED
  EXPERIENCE_SELECTED
  PLACE_VIEWED
  PLACE_EXPLORED
  ALTERNATIVE_SELECTED
  ITINERARY_CREATED
  ITINERARY_STOP_KEPT
  ITINERARY_STOP_SWAPPED
  TAKE_HOME_VIEWED
  TAKE_HOME_SELECTED
  CATEGORY_SELECTED
}

model TravelerMemory {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  type          MemoryType
  key           String
  value         String
  source        MemorySource     @default(INFERRED)
  confidence    MemoryConfidence @default(MODERATE)
  weight        Float            @default(1.0)
  evidenceCount Int              @default(1) @map("evidence_count")
  lastUsedAt    DateTime?        @map("last_used_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  expiresAt     DateTime?        @map("expires_at")
  userVisible   Boolean          @default(true) @map("user_visible")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events MemoryEvent[]

  @@unique([userId, type, key])
  @@index([userId])
  @@index([userId, type])
  @@index([userId, userVisible])
  @@map("traveler_memories")
}

model MemoryEvent {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  memoryId    String?         @map("memory_id")
  eventType   MemoryEventType @map("event_type")
  subjectType String?         @map("subject_type")
  subjectId   String?         @map("subject_id")
  signalKey   String          @map("signal_key")
  signalValue String          @map("signal_value")
  weightDelta Float           @default(0.0) @map("weight_delta")
  createdAt   DateTime        @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory TravelerMemory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("memory_events")
}

model TravelerMemorySetting {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  memoryEnabled Boolean  @default(true) @map("memory_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("traveler_memory_settings")
}


